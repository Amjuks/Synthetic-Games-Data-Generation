# MODEL_PROVIDER can be openai, custom_chat, or tensorstudio.
MODEL_PROVIDER=openai

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional:
# OPENAI_BASE_URL=
# OPENAI_TEMPERATURE=0.8
# OPENAI_MAX_TOKENS=800
# OPENAI_TIMEOUT=60

# Custom chat-completions provider:
# MODEL_PROVIDER=custom_chat
# CUSTOM_API_URL=http://172.17.99.11:30000/v1/chat/completions
# CUSTOM_API_KEY=your_custom_api_key_here
# CUSTOM_MODEL=gpt-oss-120b
# CUSTOM_TEMPERATURE=0.1
# CUSTOM_MAX_TOKENS=800
# CUSTOM_TIMEOUT=60
# CUSTOM_REASONING=Low
# CUSTOM_ENABLE_THINKING=false

# TensorStudio chat-completions provider:
# MODEL_PROVIDER=tensorstudio
# TENSORSTUDIO_API_URL=https://api.tensorstudio.ai/v1/chat/completions
# TENSORSTUDIO_API_KEY=your_tensorstudio_api_key_here
# TENSORSTUDIO_MODEL=glm-5.2-fp8
# TENSORSTUDIO_TEMPERATURE=0.8
# TENSORSTUDIO_MAX_TOKENS=800
# TENSORSTUDIO_TIMEOUT=300
# TENSORSTUDIO_SESSION_ID=sudoku-generation
